# Copy to .env.local and fill in. Never commit .env.local.

# === Auth (Clerk) ===
# Get from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk URLs (defaults work; override if you change the routes)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app

# === Database (MongoDB Atlas) ===
# Get from https://cloud.mongodb.com → Database → Connect → Drivers
# Pick "M0 Free" cluster, allow access from anywhere (0.0.0.0/0) for dev
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/humora?retryWrites=true&w=majority

# === AI Providers ===
# Required: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional fallback: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# === Payments (Stripe) ===
# https://dashboard.stripe.com/apikeys (use test keys for dev)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe price IDs (create products first, then paste IDs here)
STRIPE_PRO_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...

# === Rate limiting (Upstash Redis) ===
# https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# === Email (Resend) ===
# https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@humora.ai

# === Analytics (PostHog) ===
# https://app.posthog.com → Project Settings → API Keys
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
